<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/root"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aurora_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/aurora_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- Tema -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/theme" />

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/themeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_system"
                    android:textColor="@color/aurora_text" />

                <RadioButton
                    android:id="@+id/themeLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light"
                    android:textColor="@color/aurora_text" />

                <RadioButton
                    android:id="@+id/themeDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark"
                    android:textColor="@color/aurora_text" />
            </RadioGroup>

            <!-- Fundo -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/background" />

            <RadioGroup
                android:id="@+id/bgGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/bgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_theme"
                    android:textColor="@color/aurora_text" />

                <RadioButton
                    android:id="@+id/bgColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_color"
                    android:textColor="@color/aurora_text" />

                <RadioButton
                    android:id="@+id/bgWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_wallpaper"
                    android:textColor="@color/aurora_text" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBgColor"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/choose_bg_color" />

            <TextView
                android:id="@+id/bgBlurTitle"
                style="@style/AuroraSectionTitle"
                android:text="@string/wallpaper_blur" />
            <TextView
                android:id="@+id/bgBlurValue"
                style="@style/AuroraValue"
                android:text="12" />
            <com.google.android.material.slider.Slider
                android:id="@+id/bgBlurSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="25"
                android:stepSize="1"
                android:value="12" />

            <TextView
                android:id="@+id/bgLiveHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wallpaper_live_hint"
                android:textColor="@color/aurora_text_dim"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bgScrimTitle"
                style="@style/AuroraSectionTitle"
                android:text="@string/background_overlay" />
            <TextView
                android:id="@+id/bgScrimValue"
                style="@style/AuroraValue"
                android:text="40%" />
            <com.google.android.material.slider.Slider
                android:id="@+id/bgScrimSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="80"
                android:stepSize="5"
                android:value="40" />

            <!-- Cor de destaque -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/accent_color" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/accentRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomColor"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/choose_color" />

            <!-- Ícones -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/icon_size" />
            <TextView
                android:id="@+id/iconSizeValue"
                style="@style/AuroraValue"
                android:text="42 dp" />
            <com.google.android.material.slider.Slider
                android:id="@+id/iconSizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="28"
                android:valueTo="64"
                android:stepSize="2"
                android:value="42" />

            <!-- Zoom -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/ui_zoom" />
            <TextView
                android:id="@+id/zoomValue"
                style="@style/AuroraValue"
                android:text="100%" />
            <com.google.android.material.slider.Slider
                android:id="@+id/zoomSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="85"
                android:valueTo="130"
                android:stepSize="5"
                android:value="100" />

            <!-- Grade -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/columns" />
            <TextView
                android:id="@+id/columnsValue"
                style="@style/AuroraValue"
                android:text="1" />
            <com.google.android.material.slider.Slider
                android:id="@+id/columnsSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="5"
                android:stepSize="1"
                android:value="1" />

            <TextView style="@style/AuroraSectionTitle" android:text="@string/rows" />
            <TextView
                android:id="@+id/rowsValue"
                style="@style/AuroraValue"
                android:text="6" />
            <com.google.android.material.slider.Slider
                android:id="@+id/rowsSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="3"
                android:valueTo="8"
                android:stepSize="1"
                android:value="6" />

            <!-- Aparência dos ícones -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/icon_style" />
            <Spinner
                android:id="@+id/styleSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView style="@style/AuroraSectionTitle" android:text="@string/icon_shape" />
            <Spinner
                android:id="@+id/shapeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <!-- Ordenação -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/sort" />
            <Spinner
                android:id="@+id/sortSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/reset_defaults"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
