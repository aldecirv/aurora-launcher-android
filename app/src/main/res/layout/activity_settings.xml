<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aurora_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/aurora_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- Tema -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/theme" />

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/themeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_system"
                    android:textColor="@color/aurora_text" />

                <RadioButton
                    android:id="@+id/themeLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light"
                    android:textColor="@color/aurora_text" />

                <RadioButton
                    android:id="@+id/themeDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark"
                    android:textColor="@color/aurora_text" />
            </RadioGroup>

            <!-- Ícones -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/icon_size" />
            <TextView
                android:id="@+id/iconSizeValue"
                style="@style/AuroraValue"
                android:text="42 dp" />
            <com.google.android.material.slider.Slider
                android:id="@+id/iconSizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="28"
                android:valueTo="64"
                android:stepSize="2"
                android:value="42" />

            <!-- Zoom -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/ui_zoom" />
            <TextView
                android:id="@+id/zoomValue"
                style="@style/AuroraValue"
                android:text="100%" />
            <com.google.android.material.slider.Slider
                android:id="@+id/zoomSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="85"
                android:valueTo="130"
                android:stepSize="5"
                android:value="100" />

            <!-- Grade -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/columns" />
            <TextView
                android:id="@+id/columnsValue"
                style="@style/AuroraValue"
                android:text="1" />
            <com.google.android.material.slider.Slider
                android:id="@+id/columnsSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="5"
                android:stepSize="1"
                android:value="1" />

            <TextView style="@style/AuroraSectionTitle" android:text="@string/rows" />
            <TextView
                android:id="@+id/rowsValue"
                style="@style/AuroraValue"
                android:text="6" />
            <com.google.android.material.slider.Slider
                android:id="@+id/rowsSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="3"
                android:valueTo="8"
                android:stepSize="1"
                android:value="6" />

            <!-- Aparência dos ícones -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/icon_style" />
            <Spinner
                android:id="@+id/styleSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView style="@style/AuroraSectionTitle" android:text="@string/icon_shape" />
            <Spinner
                android:id="@+id/shapeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <!-- Ordenação -->
            <TextView style="@style/AuroraSectionTitle" android:text="@string/sort" />
            <Spinner
                android:id="@+id/sortSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/reset_defaults"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
